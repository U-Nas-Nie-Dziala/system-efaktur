{
    "$schema": "https://swc.rs/schema.json",
    "module": {
        "type": "commonjs"
    },
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "baseUrl": "./",
        "paths": {
            "@/*": ["./src/*"]
        },
        "target": "es2016",
        "loose": false,
        "externalHelpers": false
    },
    "minify": false
}
