generator client {
  provider = "prisma-client"
  output   = "./../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id         String     @id @default(uuid())
  firstname  String     @db.VarChar(64)
  lastname   String     @db.VarChar(64)
  email      String     @db.VarChar(255)
  password   String     @db.VarChar(64)
  company    Companies?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  tokens     Tokens[]
}

model Tokens {
  id         String   @id @default(uuid())
  userId     String
  user       Users    @relation(fields: [usersId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  invalided  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  usersId    String
}

enum CompanyType {
  JDG                 @map("Jednoosobowa działalność gospodarcza")
  SC                  @map("Spółka cywilna")
  SPJ                 @map("Spółka jawna")
  SPP                 @map("Spółka partnerska")
  SPK                 @map("Spółka komandytowa")
  SKA                 @map("Spółka komandytowo-akcyjna")
  SPZOO               @map("Spółka z ograniczoną odpowiedzialnością")
  PSA                 @map("Prosta spółka akcyjna")
  SA                  @map("Spółka akcyjna")
  SPOLDZ              @map("Spółdzielnia")
  FUNDACJA            @map("Fundacja")
  STOWARZYSZENIE      @map("Stowarzyszenie rejestrowe")
  SPZOZ               @map("Samodzielny publiczny zakład opieki zdrowotnej")
  JEDNOSTKA_BUDZETOWA @map("Jednostka budżetowa")
  ODDZIAL_ZAGR        @map("Oddział przedsiębiorcy zagranicznego")
  INNE                @map("Inna forma prawna")
}

model Companies {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         Users       @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  name         String      @db.VarChar(255)
  type         CompanyType
  nip          String      @db.Char(10)
  regon        String      @db.Char(14)
  bdo          String?     @db.Char(20)
  krs          String?     @db.Char(10)
  street       String      @db.VarChar(100)
  address      String      @db.Char(10)
  zipcode      String      @db.Char(6)
  city         String      @db.VarChar(100)
  country      String      @db.VarChar(50)
  registerDate DateTime    @db.Date()
  vat          Boolean
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  clients      Clients[]
  invoices     Invoices[]
}

model Clients {
  id         String     @id @default(uuid())
  ownerId    String
  owner      Companies  @relation(fields: [ownerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  name       String     @db.VarChar(255)
  nip        String     @db.Char(10)
  regon      String     @db.Char(14)
  street     String     @db.VarChar(100)
  address    String     @db.Char(10)
  zipcode    String     @db.Char(6)
  city       String     @db.VarChar(100)
  country    String     @db.VarChar(50)
  email      String?    @db.VarChar(255)
  phone      String?    @db.VarChar(12) // with code code ex. 48xxxXXXxxx
  isCompany  Boolean
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  invoices   Invoices[]
}

enum InvoiceType {
  FA_VAT // fak vat
  FA_KOR // fak korygująca
  FA_RR // fak rol. ryczałtowy
  FA_MP // fak marża
  FA_ZAL // fak zaliczkowa
  FA_WNT // fak wewnętrzwspólnotowe nabycie
  FA_WDT // wewnątrzwspólnotowa dostawa
  FA_EXP // fak eksportowa
  FA_UPR // fak uproszczona (małe kwoty)
  FA_ZB // faktura zbiorcza
}

enum InvoiceStatus {
  DRAFT // faktura robocza
  CREATED // fakuta zapisana, kompletna
  SIGNED // podpisana, nie wysłana do ksef
  SENT // podpisana, wysłana do ksef
  ACCEPTED // zaakceptowana przez ksef
  REJECTED // odrzucona przez ksef
  RECEIVED // odebrana z ksef
}

enum InvoiceCurrency {
  PLN
}

enum InvoicePaymentMethod {
  TRANSFER // przelew
  CASH // gotówka
  CASH_DELIVERY // za pobraniem
}

model Invoices {
  id            String          @id @default(uuid())
  ownerId       String
  owner         Companies       @relation(fields: [ownerId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  nr            String          @unique @db.VarChar(50)
  type          InvoiceType
  status        InvoiceStatus
  exhibitorId   String? // jeżeli null faktura została wystawiona przez ownerId, jeżeli nie null jest to faktura kosztowa dla ownerId
  exhibitor     Clients?        @relation(fields: [exhibitorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  issueDate     DateTime        @db.Date
  issuePlace    String          @db.VarChar(100) // miejsce sporządzenia faktury, np. miasto
  executeDate   DateTime        @db.Date // data wykonania usługi/sprzedaży
  paymentDate   DateTime?       @db.Date
  currency      InvoiceCurrency @default(PLN)
  ksefId        String?         @db.VarChar(100)
  ksefReference String?         @db.VarChar(100)
  netto         Decimal         @db.Decimal(12, 2)
  vat           Decimal         @db.Decimal(12, 2)
  brutto        Decimal         @db.Decimal(12, 2)
  vatFree       Boolean // czy zwolniona z VAT
  vatFreeReason String          @db.VarChar(255) // w widoku umieść gotowe do wybrania powody np.: Art. 113 ust. 1 ustawy o VAT
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  invoiceItems  InvoiceItems[]
}

enum InvoiceItemUnit {
  SZT // sztuka
  KG
  USŁ // usługa
  L // litr
}

model InvoiceItems {
  id         String          @id @default(uuid())
  invoiceId  String
  invoice    Invoices        @relation(fields: [invoiceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  name       String          @db.VarChar(255) // nazwa towaru/usługi
  unit       InvoiceItemUnit
  count      Decimal         @db.Decimal(12, 3)
  netto      Decimal         @db.Decimal(12, 2)
  varRate    Decimal         @db.Decimal(5, 2) // np. 23.00%, 8.00%
  vat        Decimal         @db.Decimal(12, 2)
  brutto     Decimal         @db.Decimal(12, 2)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
}
