{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM"],
        "strict": true,

        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "baseUrl": ".",
        "paths": {
            "@repo/contract": ["packages/contract/src"]
        },

        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    }
}
